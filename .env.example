# Copia este archivo a .env y rellena los valores. Nunca subas .env al repositorio.

# Conexión a PostgreSQL usada por la aplicación en tiempo de ejecución.
# En Vercel + Neon: usa la cadena CON pooling (host con "-pooler").
DATABASE_URL="postgresql://USUARIO:CONTRASEÑA@localhost:5432/dungeonsouls?schema=public"

# Opcional: conexión directa (sin pooling) para ejecutar migraciones con Prisma.
# Si no se define, las migraciones usan DATABASE_URL.
# DIRECT_URL="postgresql://USUARIO:CONTRASEÑA@HOST-DIRECTO:5432/dungeonsouls?sslmode=require"

# SOLO para pruebas E2E (CI): compila el piloto automático que completa un piso en el navegador.
# No lo definas en Vercel ni en producción.
# NEXT_PUBLIC_E2E_AUTOPILOT="1"
