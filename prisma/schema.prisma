// Esquema de las fases 1 (fundación), 2 (combate), 3 (progresión) y 4 (multijugador). El diseño completo de todas las fases está en docs/modelo-datos.md.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  /// Siempre en minúsculas; se normaliza antes de guardar.
  email        String   @unique
  username     String
  /// Clave normalizada (minúsculas) para unicidad sin distinguir mayúsculas.
  usernameKey  String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions    Session[]
  characters  Character[]
  partyMember PartyMember?
}

/// Sesiones de servidor. El navegador solo guarda un token aleatorio; aquí se guarda su hash SHA-256.
model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// Registro de intentos de autenticación para limitar la tasa de solicitudes entre instancias.
model AuthAttempt {
  id        String          @id @default(cuid())
  kind      AuthAttemptKind
  /// Clave del límite: "email:<hash>" o "ip:<hash>". Nunca la contraseña.
  key       String
  success   Boolean
  createdAt DateTime        @default(now())

  @@index([kind, key, createdAt])
  @@index([createdAt])
}

enum AuthAttemptKind {
  LOGIN
  REGISTER
}

enum CharacterClass {
  TANK
  DPS
  HEALER
}

/// Progreso permanente del personaje. El progreso temporal de una expedición vivirá en otras tablas (fase 2+).
model Character {
  id        String         @id @default(cuid())
  userId    String
  name      String
  /// Nombre normalizado para unicidad global sin distinguir mayúsculas.
  nameKey   String         @unique
  class     CharacterClass
  level     Int            @default(1)
  /// XP acumulada dentro del nivel actual.
  experience Int           @default(0)
  /// Puntos de atributo sin asignar.
  statPoints  Int          @default(0)
  /// Puntos de habilidad sin gastar (se usan en la fase 3).
  skillPoints Int          @default(0)

  /// Puntos asignados manualmente. Los totales se calculan con src/game/stats.
  allocatedStrength     Int @default(0)
  allocatedDexterity    Int @default(0)
  allocatedIntelligence Int @default(0)
  allocatedVitality     Int @default(0)

  /// Piso más profundo completado (desbloquea el siguiente).
  highestFloorCleared Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  runs         DungeonRun[]
  rewardGrants RewardGrant[]
  items        ItemInstance[]
  skills       CharacterSkill[]
  loadout      CharacterLoadoutSlot[]
  equipment    EquipmentSlot[]
  consumables  ConsumableStack[]
  materials    MaterialStack[]
  partyMember  PartyMember?

  @@index([userId])
}

/// Rango de una habilidad aprendida. La definición vive en src/game/skills; aquí solo el progreso.
model CharacterSkill {
  id          String   @id @default(cuid())
  characterId String
  /// Id estable de la habilidad en el código ("tank-bulwark").
  skillId     String
  /// 1..maxRank de la definición (validado en el servicio; la BD exige ≥ 1).
  rank        Int
  unlockedAt  DateTime @default(now())
  updatedAt   DateTime @updatedAt

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([characterId, skillId])
}

enum SkillSlot {
  BASIC_1
  BASIC_2
  BASIC_3
  ULTIMATE
}

/// Habilidades equipadas: como máximo una por hueco (4 en total) y sin repetir.
model CharacterLoadoutSlot {
  id          String    @id @default(cuid())
  characterId String
  slot        SkillSlot
  skillId     String

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([characterId, slot])
  @@unique([characterId, skillId])
}

enum EquipmentSlotId {
  WEAPON
  HELMET
  CHEST
  GLOVES
  LEGS
  BOOTS
  ACCESSORY_1
  ACCESSORY_2
}

/// Objeto equipado en un hueco. Un objeto solo puede estar en un hueco y no se puede borrar mientras está puesto.
model EquipmentSlot {
  id             String          @id @default(cuid())
  characterId    String
  slot           EquipmentSlotId
  itemInstanceId String          @unique

  character Character    @relation(fields: [characterId], references: [id], onDelete: Cascade)
  item      ItemInstance @relation(fields: [itemInstanceId], references: [id], onDelete: NoAction)

  @@unique([characterId, slot])
}

/// Consumibles apilables (pociones). `quantity` tiene tope por tipo (src/game/items/consumables.ts).
model ConsumableStack {
  id           String @id @default(cuid())
  characterId  String
  consumableId String
  quantity     Int    @default(0)

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([characterId, consumableId])
}

/// Materiales obtenidos al desmontar objetos.
model MaterialStack {
  id          String @id @default(cuid())
  characterId String
  materialId  String
  quantity    Int    @default(0)

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([characterId, materialId])
}

enum Difficulty {
  NORMAL
  HARD
  NIGHTMARE
  ABYSS
}

enum RunStatus {
  ACTIVE
  COMPLETED
  FAILED
  ABANDONED
}

enum ItemRarity {
  COMMON
  UNCOMMON
  RARE
  EPIC
  LEGENDARY
  MYTHIC
}

/// Un intento de un piso (progreso temporal). La semilla, la dificultad y la instantánea del
/// personaje se fijan al crearlo y no cambian: con ellas el servidor vuelve a ejecutar la partida.
model DungeonRun {
  id          String     @id @default(cuid())
  characterId String
  floor       Int
  difficulty  Difficulty @default(NORMAL)
  /// Semilla de generación (entero positivo de 31 bits).
  seed        Int
  /// Versión de las reglas de simulación con la que empezó.
  simVersion  Int
  /// Instantánea del personaje al empezar (nivel y puntos asignados), validada con Zod.
  levelAtStart     Int
  allocatedAtStart Json
  /// Habilidades equipadas al empezar [{ skillId, rank } | null] × 4 (validado con Zod).
  loadoutAtStart   Json?
  /// Bonificación del equipo y efectos únicos al empezar (validado con Zod).
  gearAtStart      Json?
  /// Pociones con las que entra (ya limitadas por pociones por piso).
  potionsAtStart   Int        @default(0)
  status      RunStatus  @default(ACTIVE)
  /// Envíos rechazados (entradas incompletas); al superar el máximo, el intento se abandona.
  rejectedSubmissions Int @default(0)
  /// Resumen del resultado verificado por el servidor (validado con Zod).
  outcome     Json?
  ticks       Int?
  startedAt   DateTime   @default(now())
  endedAt     DateTime?

  /// Fase 4: el intento forma parte de una expedición en grupo (la simula el servidor de partida;
  /// nunca se valida por repetición). `partySlot` es su posición en la simulación.
  expeditionId String?
  partySlot    Int?

  character   Character    @relation(fields: [characterId], references: [id], onDelete: Cascade)
  expedition  Expedition?  @relation(fields: [expeditionId], references: [id], onDelete: Cascade)
  rewardGrant RewardGrant?

  @@unique([expeditionId, partySlot])
  @@unique([expeditionId, characterId])
  @@index([characterId, status])
  @@index([characterId, startedAt])
}

/// Recompensa concedida. `idempotencyKey` es único: aplicar dos veces la misma recompensa es imposible.
model RewardGrant {
  id             String   @id @default(cuid())
  idempotencyKey String   @unique
  characterId    String
  runId          String   @unique
  xp             Int
  levelsGained   Int
  createdAt      DateTime @default(now())

  character Character      @relation(fields: [characterId], references: [id], onDelete: Cascade)
  run       DungeonRun     @relation(fields: [runId], references: [id], onDelete: Cascade)
  items     ItemInstance[]

  @@index([characterId])
}

/// Objeto concreto del inventario. La definición base vive en el código (src/game/items).
model ItemInstance {
  id          String     @id @default(cuid())
  characterId String
  baseItemId  String
  rarity      ItemRarity
  itemLevel   Int
  /// Afijos [{ id, value }], validados con Zod al leer y al escribir.
  affixes     Json
  sourceRewardGrantId String?
  createdAt   DateTime   @default(now())

  character   Character      @relation(fields: [characterId], references: [id], onDelete: Cascade)
  sourceGrant RewardGrant?   @relation(fields: [sourceRewardGrantId], references: [id], onDelete: SetNull)
  equippedIn  EquipmentSlot?

  @@index([characterId, createdAt])
}

enum PartyStatus {
  OPEN
  IN_EXPEDITION
  CLOSED
}

/// Grupo de hasta 4 jugadores (BALANCE.multiplayer.maxPartySize), unido con un código.
model Party {
  id           String      @id @default(cuid())
  /// 6 caracteres sin ambigüedades (sin 0/O, 1/I/L).
  code         String      @unique
  leaderUserId String
  status       PartyStatus @default(OPEN)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  members     PartyMember[]
  expeditions Expedition[]

  @@index([status])
}

/// Miembro de un grupo activo. Un usuario (y un personaje) solo está en un grupo a la vez.
model PartyMember {
  id          String   @id @default(cuid())
  partyId     String
  userId      String   @unique
  characterId String   @unique
  ready       Boolean  @default(false)
  joinedAt    DateTime @default(now())

  party     Party     @relation(fields: [partyId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@index([partyId])
}

enum ExpeditionStatus {
  ACTIVE
  COMPLETED
  DEFEATED
  ABANDONED
}

/// Expedición en grupo: un piso jugado en el servidor de partida. Piso, dificultad, semilla y
/// versión de reglas se fijan al crearla. Cada participante tiene su DungeonRun (instantánea y recompensa).
model Expedition {
  id          String           @id @default(cuid())
  partyId     String
  floor       Int
  difficulty  Difficulty       @default(NORMAL)
  seed        Int
  simVersion  Int
  /// Jugadores al empezar (escalado de enemigos).
  playerCount Int
  status      ExpeditionStatus @default(ACTIVE)
  /// Resultado firmado recibido del servidor de partida (validado con Zod).
  result      Json?
  startedAt   DateTime         @default(now())
  endedAt     DateTime?

  party Party        @relation(fields: [partyId], references: [id], onDelete: Cascade)
  runs  DungeonRun[]

  @@index([partyId, status])
}
